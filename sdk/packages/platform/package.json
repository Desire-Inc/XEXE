{
	"name": "@xexe/platform",
	"description": "XEXE Agent Workbench platform foundation for task orchestration, worktrees, workspace intelligence, memory, MCP, providers, and CLI workflows.",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"bin": {
		"xexe": "./src/cli.ts",
		"agent-workbench": "./src/cli.ts"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./cli": {
			"types": "./src/cli.ts",
			"import": "./src/cli.ts"
		}
	},
	"files": ["dist", "src"],
	"scripts": {
		"build": "bun tsc -p tsconfig.json",
		"typecheck": "bun tsc -p tsconfig.json --noEmit",
		"test": "vitest run --config vitest.config.ts"
	},
	"dependencies": {
		"nanoid": "^5.1.7",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@types/bun": "^1.3.13",
		"@types/node": "^25.3.5",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}
